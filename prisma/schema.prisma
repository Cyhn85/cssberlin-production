// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // omitApi lets lib/db.ts drop Product.reservedById from every query result by
  // default. The product endpoints fetch with `include`, which returns every
  // scalar on the model - so the moment a column is added to the schema it is
  // in the public JSON. That is how the 3072-float image embedding ended up on
  // the wire, and reservedById would have published which user is mid-checkout
  // on which item. Omitting centrally is the only fix that also covers the
  // next column somebody adds.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ══════════ USER & AUTH SYSTEM (PHASE 3) ══════════
model User {
  passwordResetTokens PasswordResetToken[]
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  name                String?
  username            String?              @unique
  bio                 String?              @db.Text
  location            String?
  avatar              String?

  // Public location, Kleinanzeigen style: PLZ + city only, never a street.
  // lat/lng are the PLZ centroid (geocoded server side) and are only ever
  // shown blurred to ~1 km on the seller map.
  postalCode String?
  city       String?
  lat        Float?
  lng        Float?
  lastSeenAt DateTime?

  // Notification preferences: { [category]: { inApp: bool, email: bool } }.
  // Missing keys fall back to the defaults in src/config/notification-policy.ts.
  notificationPrefs Json?
  // Seller rule: offers below this share of the list price are declined
  // before they are created (no message is ever sent on the seller's behalf).
  offerMinPercent   Int?
  role              UserRole @default(USER) // USER, BUSINESS, ADMIN

  // Verifications & Trust (German Compliance & Vinted Style)
  isVerified    Boolean @default(false)
  phoneVerified Boolean @default(false)
  idVerified    Boolean @default(false)
  dac7Reported  Boolean @default(false) // EU Tax reporting flag

  // Moderation (Admin panel)
  isSuspended     Boolean   @default(false)
  suspendedReason String?   @db.Text
  suspendedAt     DateTime?

  // Eco Impact Statistics
  ecoCO2Saved   Float @default(0.0)
  itemsRecycled Int   @default(0)

  // Persona (pool) seller accounts: real accounts created and owned by an
  // operator, never independently logged into. Every reply sent "as" a
  // persona is authored/approved by managedBy — see src/lib/persona-auth.ts.
  isPersonaAccount Boolean @default(false)
  managedByUserId  String?
  managedBy        User?   @relation("PersonaManager", fields: [managedByUserId], references: [id])
  managedPersonas  User[]  @relation("PersonaManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  products        Product[]
  givenReviews    Review[]        @relation("Author")
  receivedReviews Review[]        @relation("Target")
  offersMade      Offer[]         @relation("BuyerOffers")
  offersReceived  Offer[]         @relation("SellerOffers")
  ordersAsBuyer   Order[]         @relation("BuyerOrders")
  ordersAsSeller  Order[]         @relation("SellerOrders")
  sentMessages    Message[]       @relation("Sender")
  recvMessages    Message[]       @relation("Receiver")
  followers       Follow[]        @relation("Followed")
  following       Follow[]        @relation("Follower")
  favorites       Favorite[]
  accounts        Account[] // Nextauth
  sessions        Session[] // Nextauth
  bundleDiscount  BundleDiscount?
  cartItems       CartItem[]
  savedSearches   SavedSearch[]
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model SavedSearch {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String
  // catalogue query string as the user saw it, e.g. "q=levis&category=Herren&maxPrice=40"
  query          String   @db.Text
  lastNotifiedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId])
}

model BundleDiscount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive   Boolean @default(false)
  twoItems   Int?    @default(5) // percentage
  threeItems Int?    @default(10)
  fiveItems  Int?    @default(15)
}

enum UserRole {
  USER
  BUSINESS
  ADMIN
}

model Follow {
  followerId String
  followedId String
  follower   User     @relation("Follower", fields: [followerId], references: [id])
  followed   User     @relation("Followed", fields: [followedId], references: [id])
  createdAt  DateTime @default(now())

  @@id([followerId, followedId])
}

// ══════════ PRODUCT LISTING SYSTEM (PHASE 4) ══════════
model Product {
  id            String        @id @default(cuid())
  title         String
  description   String?       @db.Text
  price         Float
  originalPrice Float?
  size          String?
  brand         String?
  condition     ConditionType
  status        ProductStatus @default(ACTIVE)
  shippingCost  Float         @default(0.0) // If seller sets fixed shipping

  // Checkout reservation. Stock is always 1 here, so two buyers reaching
  // checkout in the same second would both get a payment session and both
  // could pay. Claiming the row flips status to RESERVED; these two columns
  // say until when and for whom, which is what makes the claim releasable.
  // Without an expiry, the first abandoned checkout locks the item forever -
  // trading oversell for unsellable. Released by /api/cron/cleanup.
  reservedUntil DateTime?
  reservedById  String?

  // Moderation (Admin panel)
  moderationReason String?   @db.Text
  moderatedAt      DateTime?

  // Metrics
  views       Int   @default(0)
  likes       Int   @default(0)
  ecoCO2Saved Float @default(0.0) // Impact of this specific item

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id])

  // Provenance for items imported via the TATANGA bridge (POST /api/products/import).
  // Null for normal user-created listings.
  sourcePlatform String?
  sourceUrl      String? @db.Text
  sourceHubId    String? @unique

  images    ProductImage[]
  offers    Offer[]
  orders    Order[]
  favorites Favorite[]
  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ConditionType {
  NEW_WITH_TAGS
  NEW_WITHOUT_TAGS
  VERY_GOOD
  GOOD
  ACCEPTABLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  RESERVED
  SOLD
}

model ProductImage {
  id         String  @id @default(cuid())
  url        String
  thumbUrl   String?
  mediumUrl  String?
  orderIndex Int
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  // Gemini multimodal embedding (gemini-embedding-2) for real visual similarity search.
  // Populated best-effort at upload time; null until then or if generation fails.
  embedding  Float[] @default([])
  // One of FRONT/BACK/TOP/BOTTOM/LEFT/RIGHT (src/lib/product-angles.ts) if this
  // photo is part of a deliberate 6-angle set; null for regular gallery photos.
  angle      String?
}

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  emoji    String?
  color    String?
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
}

model Favorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ══════════ BARGAINING & OFFERS (PHASE 5) ══════════
model Offer {
  id           String      @id @default(cuid())
  offeredPrice Float
  status       OfferStatus @default(PENDING)

  productId String
  product   Product @relation(fields: [productId], references: [id])
  buyerId   String
  buyer     User    @relation("BuyerOffers", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("SellerOffers", fields: [sellerId], references: [id])

  messages Message[] // Links chat to this specific offer negotiation
  orders   Order[] // Resolves to an order if accepted

  // Negotiation bookkeeping (src/config/offer-policy.ts):
  // createdById = who named this price (buyer or seller), round = 1 for the
  // opening offer, +1 per counter. expiresAt = answer deadline while PENDING,
  // payment deadline once ACCEPTED.
  createdById String?
  round       Int       @default(1)
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
}

// ══════════ TRANSACTIONS & ESCROW (PHASE 5) ══════════
model Order {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyerId   String
  buyer     User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("SellerOrders", fields: [sellerId], references: [id])
  offerId   String?
  offer     Offer?  @relation(fields: [offerId], references: [id])

  // Financials
  itemPrice     Float
  shippingFee   Float
  protectionFee Float // Käuferschutz platform fee
  totalAmount   Float

  // Logistics
  status           OrderStatus @default(PENDING_PAYMENT)
  paymentIntentId  String? // Stripe payment ID
  shippingLabelUrl String?
  trackingCode     String?
  shippingCarrier  String? // DHL, Hermes, DPD, GLS, PICKUP
  disputeReason    String?

  // How the buyer pays: card | klarna | sepa_debit | paypal | pickup_cash
  paymentMethod   String?
  // Delivery address for shipped orders (name, street, postalCode, city, country)
  shippingAddress Json?

  // Timeline stamps - deadlines are computed from these, never from updatedAt
  // (any later edit used to reset the dispute window).
  paidAt              DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  cancelledBy         String? // BUYER | SELLER | SYSTEM | ADMIN
  // Buyer asked the seller to cancel (eBay style) - seller accepts or declines
  cancelRequestedAt   DateTime?
  cancelRequestReason String?
  // Abholung: handover must happen before this, otherwise the order lapses
  pickupDeadline      DateTime?
  // Bitmask of reminders already sent (see src/lib/order-state.ts)
  remindersSent       Int       @default(0)

  // Dispute resolution (Admin panel)
  disputeResolution     String? // "REFUNDED" | "COMPLETED" - the outcome an admin chose
  disputeResolutionNote String?   @db.Text
  disputeResolvedAt     DateTime?

  reviews Review[] // buyer -> seller and seller -> buyer, one each

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_PICKUP // Abholung requested, item held until handover
  PAID // Escrow holding funds
  SHIPPED // Tracking active
  DELIVERED
  COMPLETED // Buyer confirmed, payout triggered
  DISPUTED // Käuferschutz requested
  CANCELLED
  REFUNDED
}

// ══════════ MESSAGING & CHAT (PHASE 6) ══════════
model Message {
  id      String      @id @default(cuid())
  content String      @db.Text
  type    MessageType @default(TEXT) // e.g TEXT, OFFER_CREATED, SYSTEM_ALERT
  isRead  Boolean     @default(false)

  senderId   String
  sender     User    @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver   User    @relation("Receiver", fields: [receiverId], references: [id])
  offerId    String?
  offer      Offer?  @relation(fields: [offerId], references: [id]) // Optional context

  createdAt DateTime @default(now())
}

enum MessageType {
  TEXT
  IMAGE
  OFFER_ACTION
  SYSTEM_INFO
  PERSONA_RELAY // copy of a persona's notification for its manager - bell only, never a chat thread
}

// ══════════ RATINGS & REVIEWS (PHASE 3) ══════════
model Review {
  id      String  @id @default(cuid())
  rating  Int // 1 to 5
  comment String? @db.Text

  orderId      String
  order        Order  @relation(fields: [orderId], references: [id])
  authorId     String
  author       User   @relation("Author", fields: [authorId], references: [id])
  targetUserId String
  targetUser   User   @relation("Target", fields: [targetUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orderId, authorId])
}

// ══════════ NEXTAUTH SYSTEM MODELS ══════════
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// TATANGA'nin urettigi ve INSAN TARAFINDAN ONAYLANMIS kampanya metinleri.
// Ticker/kampanya vitrini buradan beslenir; sitede metin sabitlenmez.
// Her kayit `evidence` tasir: iddianin NEDEN dogru oldugu denetlenebilir kalir.
model Campaign {
  id        String    @id @default(cuid())
  sourceId  String    @unique // TATANGA campaign_drafts.id
  kind      String // sale | new_arrival | category_spotlight | eco
  lang      String // de | en | tr
  headline  String
  body      String
  cta       String
  href      String    @default("/catalog")
  evidence  String // bu iddia neden dogru (denetim izi)
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([lang, active])
}

// Passwort-Zuruecksetzung. Gespeichert wird nur der Hash des Tokens - wer die
// Datenbank liest, kann damit kein Konto uebernehmen.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Kontaktformular + DSA-Meldungen (Notice & Action). Stored first, so nothing is
// lost while outgoing mail is not configured; mailed to the shop inbox when SMTP is set.
model ContactRequest {
  id        String   @id @default(cuid())
  topic     String // allgemein | bestellung | konto | melden | presse
  name      String
  email     String
  subject   String
  message   String   @db.Text
  url       String?  @db.Text // reported listing / profile (melden)
  userId    String?
  status    String   @default("OPEN") // OPEN | DONE
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
