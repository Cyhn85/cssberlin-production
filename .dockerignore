# Product photos live on this disk (uploads/ = 107 MB). Without this line they
# enter the build context AND Next.js traces them into .next/standalone - the
# ENOSPC that killed a deploy showed exactly that:
#   copyfile '/app/uploads/products/<id>/0.jpg' -> '/app/.next/standalone/...'
# They are runtime data mounted as a volume, never part of the image.
uploads
test_uploads

